<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/common_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/subject_demo_title" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/subject_demo_notice" android:textSize="16sp" android:paddingTop="12dp" android:paddingBottom="16dp" />
        <Button android:id="@+id/subject_demo_subjects" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/subject_demo_subjects" />
        <Button android:id="@+id/subject_demo_picker" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/subject_demo_picker" />
        <TextView android:id="@+id/subject_demo_result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/subject_demo_picker_hint"
            android:padding="8dp" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/subject_demo_month" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/subject_demo_month" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/subject_demo_tip" android:textSize="16sp" android:paddingTop="16dp" android:paddingBottom="16dp" />
        <Button android:id="@+id/subject_demo_reset" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/subject_demo_reset" />
    </LinearLayout>
</ScrollView>
