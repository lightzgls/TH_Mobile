<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:allowBackup="false" android:supportsRtl="true"
        android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@drawable/ic_launcher"
        android:label="@string/app_name" android:theme="@style/Theme.StudySchedule">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".activities.AdminHomeActivity" android:exported="false" />
        <activity android:name=".activities.StudentHomeActivity" android:exported="false" />
        <activity android:name=".activities.LoginActivity" android:exported="false" />
        <activity android:name=".activities.StudentListActivity" android:exported="false" />
        <activity android:name=".activities.StudentFormActivity" android:exported="false" />
        <activity android:name=".activities.StudentDetailActivity" android:exported="false" />
        <activity android:name=".activities.SubjectListActivity" android:exported="false" />
        <activity android:name=".activities.SubjectFormActivity" android:exported="false" />
        <activity android:name=".activities.SubjectPickerActivity" android:exported="false" />
        <activity android:name=".activities.MonthCalendarActivity" android:exported="false" />
        <activity android:name=".activities.BookingFormActivity" android:exported="false" />
        <activity android:name=".activities.ScheduleListActivity" android:exported="false" />
        <activity android:name=".activities.ScheduleDetailActivity" android:exported="false" />
        <activity android:name=".activities.DayWeekCalendarActivity" android:exported="false" />
        <receiver android:name=".notifications.TimeChangeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
