<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/common_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auth_login_title" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auth_login_hint" android:paddingTop="8dp" android:paddingBottom="24dp" />
        <EditText android:id="@+id/auth_username" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:hint="@string/auth_username" android:inputType="text"
            android:autofillHints="username" android:singleLine="true" android:maxLength="100" />
        <EditText android:id="@+id/auth_password" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:hint="@string/auth_password" android:inputType="textPassword"
            android:autofillHints="password" android:saveEnabled="false"
            android:singleLine="true" android:maxLength="256" />
        <TextView android:id="@+id/auth_message" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"
            android:paddingTop="12dp" android:paddingBottom="12dp" />
        <Button android:id="@+id/auth_submit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/auth_login_title" />
        <Button android:id="@+id/auth_login_back" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/common_back" />
    </LinearLayout>
</ScrollView>
