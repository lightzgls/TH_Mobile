<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/common_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/month_calendar_title" android:textStyle="bold" android:textSize="24sp" />
        <TextView android:id="@+id/month_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:textSize="20sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            style="?android:attr/buttonBarStyle">
            <Button android:id="@+id/month_previous" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/month_previous" />
            <Button android:id="@+id/month_today" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/month_today" />
            <Button android:id="@+id/month_next" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/month_next" />
        </LinearLayout>
        <GridLayout android:id="@+id/month_grid" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:columnCount="7" android:orientation="horizontal" />
        <TextView android:id="@+id/month_message" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="8dp" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/month_selected" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textStyle="bold" android:textSize="18sp" />
        <Button android:id="@+id/month_open_day" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/month_open_day" android:enabled="false" />
        <Button android:id="@+id/month_book" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/month_book" android:enabled="false" />
        <LinearLayout android:id="@+id/month_schedules" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <Button android:id="@+id/month_calendar_back" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/common_back" />
    </LinearLayout>
</ScrollView>
