<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/common_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/student_form_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/student_form_add_title"
            android:textColor="#172B4D"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/student_label_code" />
        <EditText
            android:id="@+id/student_form_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/student_hint_code"
            android:inputType="textCapCharacters"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/student_label_fullname" />
        <EditText
            android:id="@+id/student_form_fullname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/student_hint_fullname"
            android:inputType="textCapWords|textPersonName"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/student_label_email" />
        <EditText
            android:id="@+id/student_form_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/student_hint_email"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/student_label_phone" />
        <EditText
            android:id="@+id/student_form_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/student_hint_phone"
            android:inputType="phone"
            android:singleLine="true" />

        <LinearLayout
            android:id="@+id/student_form_account_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/student_account_section"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/student_label_username" />
            <EditText
                android:id="@+id/student_form_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/student_hint_username"
                android:inputType="text"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/student_label_password" />
            <EditText
                android:id="@+id/student_form_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/student_hint_password"
                android:inputType="textPassword"
                android:singleLine="true" />
        </LinearLayout>

        <Button
            android:id="@+id/student_form_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/student_save" />
        <Button
            android:id="@+id/student_form_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/common_back" />
    </LinearLayout>
</ScrollView>
