<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/common_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/student_detail_title"
            android:textColor="#172B4D"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/student_label_fullname"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/student_detail_fullname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="14dp"
            android:text="—"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/student_label_code"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/student_detail_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="14dp"
            android:text="—"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/student_label_email"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/student_detail_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="14dp"
            android:text="—"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/student_label_phone"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/student_detail_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="22dp"
            android:text="—"
            android:textSize="16sp" />

        <Button
            android:id="@+id/student_detail_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/student_action_edit" />
        <Button
            android:id="@+id/student_detail_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/student_action_delete" />
        <Button
            android:id="@+id/student_detail_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/common_back" />
    </LinearLayout>
</ScrollView>
