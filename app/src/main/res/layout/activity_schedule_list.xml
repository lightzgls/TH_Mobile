<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/common_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/schedule_list_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <Button
            android:id="@+id/schedule_list_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_back" />
    </LinearLayout>

    <!-- Quick Navigation Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/schedule_list_add_booking_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/schedule_list_add_booking"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/schedule_list_open_agenda_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/schedule_list_open_agenda"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Filter Section (Pinned at Top) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!-- Keyword search input -->
        <EditText
            android:id="@+id/schedule_list_keyword_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/schedule_list_search_hint"
            android:singleLine="true"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <!-- Date Range Filter Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/schedule_list_from_date_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/schedule_list_from_date"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/schedule_list_to_date_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/schedule_list_to_date"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Status Filter Spinner -->
        <Spinner
            android:id="@+id/schedule_list_status_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- Filter Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <Button
                android:id="@+id/schedule_list_apply_filter_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/schedule_list_apply_filter"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/schedule_list_clear_filter_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/schedule_list_clear_filter"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Progress indicator -->
    <ProgressBar
        android:id="@+id/schedule_list_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Schedule List View -->
    <ListView
        android:id="@+id/schedule_list_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <!-- Empty State Container -->
    <LinearLayout
        android:id="@+id/schedule_list_empty_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/schedule_list_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_list_empty_msg"
            android:textSize="16sp"
            android:textColor="#757575"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/schedule_list_empty_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_list_add_booking" />

        <Button
            android:id="@+id/schedule_list_empty_clear_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_list_clear_filter"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</LinearLayout>
