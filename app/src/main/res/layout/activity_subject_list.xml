<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/common_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/subject_browser_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/subject_list_title"
            android:textSize="24sp" android:textStyle="bold" />
        <EditText android:id="@+id/subject_browser_search" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/subject_search_hint"
            android:inputType="text" android:imeOptions="actionSearch" android:maxLines="1"
            android:autofillHints="" />
        <Button android:id="@+id/subject_browser_find" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/subject_search" />
        <Button android:id="@+id/subject_browser_add" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/subject_add" android:enabled="false" />
        <TextView android:id="@+id/subject_browser_message" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
    <ListView android:id="@+id/subject_browser_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
    <Button android:id="@+id/subject_browser_back" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/common_back" />
</LinearLayout>
